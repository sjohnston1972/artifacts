{
  "slug": "social-links",
  "controls_schema": [
    {
      "id": "accent",
      "type": "color",
      "label": "Accent colour",
      "default": "#A8E6C1",
      "presets": ["#A8E6C1", "#F5C2E0", "#BFD9F2", "#D9C8F0", "#E8A020", "#241430"]
    },
    {
      "id": "size",
      "type": "number",
      "label": "Icon size (px)",
      "default": 20,
      "min": 12,
      "max": 32,
      "step": 1
    },
    {
      "id": "shape",
      "type": "select",
      "label": "Shape",
      "default": "circle",
      "options": ["circle", "square"]
    },
    {
      "id": "showLabels",
      "type": "toggle",
      "label": "Show text labels",
      "default": false
    }
  ],
  "templates": {
    "html": "<ul class=\"social-links social-links--{{shape}}\" style=\"--accent:{{accent}};--size:{{size}}px;\">\n  <li>\n    <a href=\"#\" class=\"social-links__link\" aria-label=\"X (Twitter)\">\n      <svg class=\"social-links__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18.9 2H22l-7.6 8.7L23 22h-6.8l-5.3-6.9L4.8 22H1.6l8.1-9.3L1 2h7l4.8 6.3L18.9 2Zm-1.2 18h1.9L7.4 4H5.4l12.3 16Z\"/></svg>\n      {{#if showLabels}}<span class=\"social-links__label\">X (Twitter)</span>{{/if}}\n    </a>\n  </li>\n  <li>\n    <a href=\"#\" class=\"social-links__link\" aria-label=\"LinkedIn\">\n      <svg class=\"social-links__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.7c0-1.36-.02-3.1-1.9-3.1-1.9 0-2.2 1.47-2.2 3v5.8h-4V9Z\"/></svg>\n      {{#if showLabels}}<span class=\"social-links__label\">LinkedIn</span>{{/if}}\n    </a>\n  </li>\n  <li>\n    <a href=\"#\" class=\"social-links__link\" aria-label=\"Instagram\">\n      <svg class=\"social-links__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm4.75-3.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z\"/></svg>\n      {{#if showLabels}}<span class=\"social-links__label\">Instagram</span>{{/if}}\n    </a>\n  </li>\n  <li>\n    <a href=\"#\" class=\"social-links__link\" aria-label=\"GitHub\">\n      <svg class=\"social-links__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.4 9.4 0 0 1 5 0c1.9-1.29 2.74-1.02 2.74-1.02.56 1.38.2 2.4.1 2.65.65.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2Z\"/></svg>\n      {{#if showLabels}}<span class=\"social-links__label\">GitHub</span>{{/if}}\n    </a>\n  </li>\n</ul>\n<style>\n.social-links { display: flex; gap: 12px; list-style: none; margin: 0; padding: 0; font: 14px/1 system-ui, sans-serif; }\n.social-links__link { display: inline-flex; align-items: center; gap: 8px; padding: 10px; border-radius: 999px; background: #241430; color: #FAF7F2; text-decoration: none; }\n.social-links--square .social-links__link { border-radius: 8px; }\n.social-links__link:hover, .social-links__link:focus-visible { background: var(--accent); color: #241430; outline: 2px solid var(--accent); outline-offset: 2px; }\n.social-links__icon { width: var(--size); height: var(--size); fill: currentColor; flex-shrink: 0; }\n</style>",
    "tailwind": "<ul class=\"social-links-tw social-links-tw--{{shape}} flex gap-3 list-none m-0 p-0 font-sans text-sm\" style=\"--accent:{{accent}};--size:{{size}}px\">\n  <li>\n    <a href=\"#\" class=\"social-links-tw__link inline-flex items-center gap-2 p-2.5 rounded-full bg-[#241430] text-[#FAF7F2] no-underline\" aria-label=\"X (Twitter)\">\n      <svg class=\"block\" style=\"width:{{size}}px;height:{{size}}px;fill:currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18.9 2H22l-7.6 8.7L23 22h-6.8l-5.3-6.9L4.8 22H1.6l8.1-9.3L1 2h7l4.8 6.3L18.9 2Zm-1.2 18h1.9L7.4 4H5.4l12.3 16Z\"/></svg>\n      {{#if showLabels}}<span>X (Twitter)</span>{{/if}}\n    </a>\n  </li>\n  <li>\n    <a href=\"#\" class=\"social-links-tw__link inline-flex items-center gap-2 p-2.5 rounded-full bg-[#241430] text-[#FAF7F2] no-underline\" aria-label=\"LinkedIn\">\n      <svg class=\"block\" style=\"width:{{size}}px;height:{{size}}px;fill:currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.7c0-1.36-.02-3.1-1.9-3.1-1.9 0-2.2 1.47-2.2 3v5.8h-4V9Z\"/></svg>\n      {{#if showLabels}}<span>LinkedIn</span>{{/if}}\n    </a>\n  </li>\n  <li>\n    <a href=\"#\" class=\"social-links-tw__link inline-flex items-center gap-2 p-2.5 rounded-full bg-[#241430] text-[#FAF7F2] no-underline\" aria-label=\"Instagram\">\n      <svg class=\"block\" style=\"width:{{size}}px;height:{{size}}px;fill:currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm4.75-3.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z\"/></svg>\n      {{#if showLabels}}<span>Instagram</span>{{/if}}\n    </a>\n  </li>\n  <li>\n    <a href=\"#\" class=\"social-links-tw__link inline-flex items-center gap-2 p-2.5 rounded-full bg-[#241430] text-[#FAF7F2] no-underline\" aria-label=\"GitHub\">\n      <svg class=\"block\" style=\"width:{{size}}px;height:{{size}}px;fill:currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.4 9.4 0 0 1 5 0c1.9-1.29 2.74-1.02 2.74-1.02.56 1.38.2 2.4.1 2.65.65.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2Z\"/></svg>\n      {{#if showLabels}}<span>GitHub</span>{{/if}}\n    </a>\n  </li>\n</ul>\n<style>\n.social-links-tw--square .social-links-tw__link { border-radius: 8px; }\n.social-links-tw__link:hover, .social-links-tw__link:focus-visible { background: {{accent}}; color: #241430; outline: 2px solid {{accent}}; outline-offset: 2px; }\n</style>",
    "react": "export function SocialLinks({\n  accent = \"{{accent}}\",\n  size = {{size}},\n  shape = \"{{shape}}\",\n  showLabels = {{showLabels}},\n}) {\n  const platforms = [\n    { name: \"X (Twitter)\", path: \"M18.9 2H22l-7.6 8.7L23 22h-6.8l-5.3-6.9L4.8 22H1.6l8.1-9.3L1 2h7l4.8 6.3L18.9 2Zm-1.2 18h1.9L7.4 4H5.4l12.3 16Z\" },\n    { name: \"LinkedIn\", path: \"M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.7c0-1.36-.02-3.1-1.9-3.1-1.9 0-2.2 1.47-2.2 3v5.8h-4V9Z\" },\n    { name: \"Instagram\", path: \"M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm4.75-3.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z\" },\n    { name: \"GitHub\", path: \"M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.4 9.4 0 0 1 5 0c1.9-1.29 2.74-1.02 2.74-1.02.56 1.38.2 2.4.1 2.65.65.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2Z\" },\n  ];\n  return (\n    <ul style={{ display: \"flex\", gap: 12, listStyle: \"none\", margin: 0, padding: 0, fontFamily: \"system-ui, sans-serif\", fontSize: 14 }}>\n      {platforms.map((p) => (\n        <li key={p.name}>\n          <a href=\"#\" aria-label={p.name} style={{\n            display: \"inline-flex\", alignItems: \"center\", gap: 8, padding: 10,\n            borderRadius: shape === \"square\" ? 8 : 999, background: \"#241430\", color: \"#FAF7F2\", textDecoration: \"none\",\n          }}>\n            <svg style={{ width: size, height: size, fill: \"currentColor\", flexShrink: 0 }} viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d={p.path} />\n            </svg>\n            {showLabels && <span>{p.name}</span>}\n          </a>\n        </li>\n      ))}\n    </ul>\n  );\n}"
  }
}
