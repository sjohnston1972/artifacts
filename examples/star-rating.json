{
  "controls_schema": [
    {
      "id": "ratingLabel",
      "type": "text",
      "label": "Rating label",
      "default": "4.5 out of 5"
    },
    {
      "id": "fillPercent",
      "type": "number",
      "label": "Fill percentage",
      "default": 90,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "id": "color",
      "type": "color",
      "label": "Star colour",
      "default": "#E8A020",
      "presets": [
        "#E8A020",
        "#A8E6C1",
        "#F5C2E0",
        "#BFD9F2",
        "#D9C8F0",
        "#241430"
      ]
    },
    {
      "id": "size",
      "type": "number",
      "label": "Star size (px)",
      "default": 24,
      "min": 12,
      "max": 48,
      "step": 2
    },
    {
      "id": "showValue",
      "type": "toggle",
      "label": "Show label text",
      "default": true
    }
  ],
  "templates": {
    "html": "<div class=\"star-rating\" role=\"img\" aria-label=\"{{ratingLabel}}\" style=\"font-size:{{size}}px;\">\n  <span class=\"star-rating__track\" aria-hidden=\"true\">\n    <span class=\"star-rating__stars star-rating__stars--empty\">★★★★★</span>\n    <span class=\"star-rating__stars star-rating__stars--filled\" style=\"width:{{fillPercent}}%;color:{{color}};\">★★★★★</span>\n  </span>\n  {{#if showValue}}<span class=\"star-rating__value\">{{ratingLabel}}</span>{{/if}}\n</div>\n<style>\n.star-rating { display: inline-flex; align-items: center; gap: 8px; font-family: system-ui, sans-serif; }\n.star-rating__track { position: relative; display: inline-block; line-height: 1; }\n.star-rating__stars { display: block; white-space: nowrap; letter-spacing: 2px; }\n.star-rating__stars--empty { color: #24143033; }\n.star-rating__stars--filled { position: absolute; inset: 0; overflow: hidden; }\n.star-rating__value { font-size: 14px; color: #241430; }\n</style>",
    "tailwind": "<div class=\"inline-flex items-center gap-2 font-sans\" role=\"img\" aria-label=\"{{ratingLabel}}\" style=\"font-size:{{size}}px\">\n  <span class=\"relative inline-block leading-none tracking-widest\" aria-hidden=\"true\">\n    <span class=\"block whitespace-nowrap text-[#24143033]\">★★★★★</span>\n    <span class=\"absolute inset-0 overflow-hidden\" style=\"width:{{fillPercent}}%;color:{{color}}\">★★★★★</span>\n  </span>\n  {{#if showValue}}<span class=\"text-sm text-[#241430]\">{{ratingLabel}}</span>{{/if}}\n</div>",
    "react": "export function StarRating({\n  ratingLabel = \"{{ratingLabel}}\",\n  fillPercent = {{fillPercent}},\n  color = \"{{color}}\",\n  size = {{size}},\n  showValue = {{showValue}},\n}) {\n  return (\n    <div role=\"img\" aria-label={ratingLabel} style={{ display: \"inline-flex\", alignItems: \"center\", gap: 8, fontFamily: \"system-ui, sans-serif\", fontSize: size }}>\n      <span aria-hidden=\"true\" style={{ position: \"relative\", display: \"inline-block\", lineHeight: 1, letterSpacing: 2 }}>\n        <span style={{ display: \"block\", whiteSpace: \"nowrap\", color: \"#24143033\" }}>★★★★★</span>\n        <span style={{ position: \"absolute\", inset: 0, overflow: \"hidden\", width: `${fillPercent}%`, color }}>★★★★★</span>\n      </span>\n      {showValue && <span style={{ fontSize: 14, color: \"#241430\" }}>{ratingLabel}</span>}\n    </div>\n  );\n}"
  },
  "slug": "star-rating"
}
