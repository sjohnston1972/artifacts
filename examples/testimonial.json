{
  "controls_schema": [
    {
      "id": "quote",
      "type": "text",
      "label": "Quote",
      "default": "This cut our design handoff time in half."
    },
    {
      "id": "authorName",
      "type": "text",
      "label": "Author name",
      "default": "Jordan Blake"
    },
    {
      "id": "authorRole",
      "type": "text",
      "label": "Author role",
      "default": "VP Engineering, Nimbus"
    },
    {
      "id": "variant",
      "type": "select",
      "label": "Style",
      "default": "card",
      "options": [
        "card",
        "bordered",
        "minimal"
      ]
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent colour",
      "default": "#BFD9F2",
      "presets": [
        "#BFD9F2",
        "#A8E6C1",
        "#F5C2E0",
        "#D9C8F0",
        "#E8A020",
        "#241430"
      ]
    }
  ],
  "templates": {
    "html": "<figure class=\"testimonial testimonial--{{variant}}\" style=\"--accent:{{accent}};\">\n  <blockquote class=\"testimonial__quote\">\n    <p>“{{quote}}”</p>\n  </blockquote>\n  <figcaption class=\"testimonial__author\">\n    <span class=\"testimonial__name\">{{authorName}}</span>\n    <span class=\"testimonial__role\">{{authorRole}}</span>\n  </figcaption>\n</figure>\n<style>\n.testimonial { font-family: system-ui, sans-serif; color: #241430; max-width: 420px; padding: 24px; margin: 0; }\n.testimonial--card { background: #FAF7F2; box-shadow: 0 8px 24px rgba(36,20,48,.14); border-radius: 12px; }\n.testimonial--bordered { border: 1.5px solid var(--accent); border-radius: 12px; }\n.testimonial--minimal { padding-left: 20px; border-left: 3px solid var(--accent); }\n.testimonial__quote { margin: 0 0 16px; font-size: 17px; line-height: 1.5; font-style: italic; }\n.testimonial__quote p { margin: 0; }\n.testimonial__author { display: flex; flex-direction: column; font-style: normal; }\n.testimonial__name { font-weight: 600; }\n.testimonial__role { font-size: 13px; color: #241430; opacity: .65; }\n</style>",
    "tailwind": "<figure class=\"testimonial-tw testimonial-tw--{{variant}} font-sans text-[#241430] max-w-[420px] p-6 m-0\" style=\"--accent:{{accent}}\">\n  <blockquote class=\"m-0 mb-4 text-[17px] leading-relaxed italic\">\n    <p class=\"m-0\">“{{quote}}”</p>\n  </blockquote>\n  <figcaption class=\"flex flex-col not-italic\">\n    <span class=\"font-semibold\">{{authorName}}</span>\n    <span class=\"text-[13px] text-[#241430]/65\">{{authorRole}}</span>\n  </figcaption>\n</figure>\n<style>\n.testimonial-tw--card { background: #FAF7F2; box-shadow: 0 8px 24px rgba(36,20,48,.14); border-radius: 12px; }\n.testimonial-tw--bordered { border: 1.5px solid var(--accent); border-radius: 12px; }\n.testimonial-tw--minimal { padding-left: 20px; border-left: 3px solid var(--accent); }\n</style>",
    "react": "export function Testimonial({\n  quote = \"{{quote}}\",\n  authorName = \"{{authorName}}\",\n  authorRole = \"{{authorRole}}\",\n  variant = \"{{variant}}\",\n  accent = \"{{accent}}\",\n}) {\n  const wrap = {\n    card: { background: \"#FAF7F2\", boxShadow: \"0 8px 24px rgba(36,20,48,.14)\", borderRadius: 12 },\n    bordered: { border: `1.5px solid ${accent}`, borderRadius: 12 },\n    minimal: { paddingLeft: 20, borderLeft: `3px solid ${accent}` },\n  }[variant] ?? {};\n  return (\n    <figure style={{ fontFamily: \"system-ui, sans-serif\", color: \"#241430\", maxWidth: 420, padding: 24, margin: 0, ...wrap }}>\n      <blockquote style={{ margin: \"0 0 16px\", fontSize: 17, lineHeight: 1.5, fontStyle: \"italic\" }}>\n        <p style={{ margin: 0 }}>“{quote}”</p>\n      </blockquote>\n      <figcaption style={{ display: \"flex\", flexDirection: \"column\", fontStyle: \"normal\" }}>\n        <span style={{ fontWeight: 600 }}>{authorName}</span>\n        <span style={{ fontSize: 13, color: \"#241430\", opacity: 0.65 }}>{authorRole}</span>\n      </figcaption>\n    </figure>\n  );\n}"
  },
  "slug": "testimonial"
}
