{
  "slug": "time-input",
  "controls_schema": [
    {
      "id": "label",
      "type": "text",
      "label": "Label",
      "default": "Start time"
    },
    {
      "id": "min",
      "type": "text",
      "label": "Minimum",
      "default": "09:00"
    },
    {
      "id": "max",
      "type": "text",
      "label": "Maximum",
      "default": "18:00"
    },
    {
      "id": "step",
      "type": "number",
      "label": "Step (seconds)",
      "default": 60,
      "min": 1,
      "max": 3600,
      "step": 1
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Focus colour",
      "default": "#F5C2E0",
      "presets": [
        "#F5C2E0",
        "#A8E6C1",
        "#BFD9F2",
        "#D9C8F0",
        "#E8A020",
        "#241430"
      ]
    }
  ],
  "templates": {
    "html": "<label class=\"tin\" for=\"tin-1\">\n  <span class=\"tin__label\">{{label}}</span>\n  <input class=\"tin__input\" id=\"tin-1\" type=\"time\" min=\"{{min}}\" max=\"{{max}}\" step=\"{{step}}\" style=\"--accent:{{accent}};\">\n</label>\n<style>\n.tin { display: block; font: 14px system-ui, sans-serif; color: #241430; max-width: 180px; }\n.tin__label { display: block; margin-bottom: 6px; font-weight: 500; }\n.tin__input { width: 100%; box-sizing: border-box; padding: 10px 12px; font: inherit; color: #241430; background: #FAF7F2; border: 1.5px solid #24143040; border-radius: 8px; }\n.tin__input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }\n</style>",
    "tailwind": "<label class=\"block max-w-[180px] font-sans text-sm text-[#241430]\" for=\"tin-tw-1\">\n  <span class=\"block mb-1.5 font-medium\">{{label}}</span>\n  <input id=\"tin-tw-1\" type=\"time\" min=\"{{min}}\" max=\"{{max}}\" step=\"{{step}}\"\n    class=\"w-full box-border px-3 py-2.5 bg-[#FAF7F2] border-[1.5px] border-[#24143040] rounded-lg focus-visible:outline-none\" style=\"border-color:{{accent}};\">\n</label>",
    "react": "export function TimeInput({\n  label = \"{{label}}\",\n  min = \"{{min}}\",\n  max = \"{{max}}\",\n  step = {{step}},\n  accent = \"{{accent}}\",\n}) {\n  return (\n    <label style={{ display: \"block\", maxWidth: 180, fontFamily: \"system-ui, sans-serif\", fontSize: 14, color: \"#241430\" }}>\n      <span style={{ display: \"block\", marginBottom: 6, fontWeight: 500 }}>{label}</span>\n      <input type=\"time\" min={min} max={max} step={step} style={{\n        width: \"100%\", boxSizing: \"border-box\", padding: \"10px 12px\", font: \"inherit\", color: \"#241430\",\n        background: \"#FAF7F2\", border: `1.5px solid ${accent}`, borderRadius: 8,\n      }} />\n    </label>\n  );\n}"
  }
}
