{
  "controls_schema": [
    {
      "id": "text",
      "type": "text",
      "label": "Text",
      "default": "Design that ships itself."
    },
    {
      "id": "align",
      "type": "select",
      "label": "Alignment",
      "default": "center",
      "options": [
        "left",
        "center",
        "right"
      ]
    },
    {
      "id": "size",
      "type": "number",
      "label": "Font size (px)",
      "default": 36,
      "min": 18,
      "max": 72,
      "step": 2
    },
    {
      "id": "color",
      "type": "color",
      "label": "Colour",
      "default": "#241430",
      "presets": [
        "#241430",
        "#A8E6C1",
        "#F5C2E0",
        "#BFD9F2",
        "#D9C8F0",
        "#E8A020"
      ]
    },
    {
      "id": "uppercase",
      "type": "toggle",
      "label": "Uppercase",
      "default": false
    }
  ],
  "templates": {
    "html": "<p class=\"tagline{{#if uppercase}} tagline--upper{{/if}}\" style=\"text-align:{{align}};font-size:{{size}}px;color:{{color}};\">{{text}}</p>\n<style>\n.tagline { margin: 0; font: 600 1em/1.3 system-ui, sans-serif; }\n.tagline--upper { text-transform: uppercase; letter-spacing: .04em; }\n</style>",
    "tailwind": "<p class=\"tagline-tw font-sans font-semibold leading-tight{{#if uppercase}} uppercase tracking-wide{{/if}}\" style=\"text-align:{{align}};font-size:{{size}}px;color:{{color}}\">{{text}}</p>",
    "react": "export function Tagline({\n  text = \"{{text}}\",\n  align = \"{{align}}\",\n  size = {{size}},\n  color = \"{{color}}\",\n  uppercase = {{uppercase}},\n}) {\n  return (\n    <p style={{\n      margin: 0,\n      fontFamily: \"system-ui, sans-serif\",\n      fontWeight: 600,\n      lineHeight: 1.3,\n      textAlign: align,\n      fontSize: size,\n      color,\n      textTransform: uppercase ? \"uppercase\" : \"none\",\n      letterSpacing: uppercase ? \"0.04em\" : \"normal\",\n    }}>\n      {text}\n    </p>\n  );\n}"
  },
  "slug": "tagline"
}
