{
  "slug": "row-selection",
  "controls_schema": [
    {
      "id": "caption",
      "type": "text",
      "label": "Caption",
      "default": "Customer orders"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#241430",
      "presets": [
        "#241430",
        "#A8E6C1",
        "#F5C2E0",
        "#BFD9F2",
        "#D9C8F0",
        "#E8A020"
      ]
    },
    {
      "id": "multiSelect",
      "type": "toggle",
      "label": "Allow multiple rows",
      "default": true
    },
    {
      "id": "activeRow",
      "type": "select",
      "label": "Highlighted row",
      "default": "1",
      "options": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "id": "stripe",
      "type": "toggle",
      "label": "Zebra striping",
      "default": false
    }
  ],
  "templates": {
    "html": "<div class=\"rsl{{#if stripe}} rsl--stripe{{/if}}\" data-active=\"{{activeRow}}\" style=\"--accent:{{accent}};\">\n  <div class=\"rsl__scroll\">\n    <table class=\"rsl__table\">\n      <caption>{{caption}}</caption>\n      <thead><tr><th scope=\"col\"><span class=\"sr-only\">Select</span></th><th scope=\"col\">Order</th><th scope=\"col\">Customer</th><th scope=\"col\">Total</th></tr></thead>\n      <tbody>\n        {{#if multiSelect}}\n        <tr><td><label class=\"rsl__chk\"><input type=\"checkbox\" checked><span class=\"sr-only\">Select order #1042</span></label></td><td>#1042</td><td>A. Whitfield</td><td>£64.00</td></tr>\n        <tr><td><label class=\"rsl__chk\"><input type=\"checkbox\"><span class=\"sr-only\">Select order #1041</span></label></td><td>#1041</td><td>R. Okafor</td><td>£128.50</td></tr>\n        <tr><td><label class=\"rsl__chk\"><input type=\"checkbox\"><span class=\"sr-only\">Select order #1040</span></label></td><td>#1040</td><td>M. Iqbal</td><td>£22.00</td></tr>\n        {{/if}}\n        {{#unless multiSelect}}\n        <tr><td><label class=\"rsl__chk\"><input type=\"radio\" name=\"rsl-row\" checked><span class=\"sr-only\">Select order #1042</span></label></td><td>#1042</td><td>A. Whitfield</td><td>£64.00</td></tr>\n        <tr><td><label class=\"rsl__chk\"><input type=\"radio\" name=\"rsl-row\"><span class=\"sr-only\">Select order #1041</span></label></td><td>#1041</td><td>R. Okafor</td><td>£128.50</td></tr>\n        <tr><td><label class=\"rsl__chk\"><input type=\"radio\" name=\"rsl-row\"><span class=\"sr-only\">Select order #1040</span></label></td><td>#1040</td><td>M. Iqbal</td><td>£22.00</td></tr>\n        {{/unless}}\n      </tbody>\n    </table>\n  </div>\n</div>\n<style>\n.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}\n.rsl { font: 14px system-ui, sans-serif; color: #241430; background: #FAF7F2; max-width: 480px; border: 1px solid #24143020; border-radius: 10px; overflow: hidden; }\n.rsl__scroll { overflow-x: auto; }\n.rsl__table { border-collapse: collapse; width: 100%; }\n.rsl__table caption { text-align: left; font-weight: 600; padding: 10px 14px; }\n.rsl__table th, .rsl__table td { padding: 10px 14px; text-align: left; border-bottom: 1px solid #24143020; white-space: nowrap; }\n.rsl__table th { background: var(--accent); color: #FAF7F2; }\n.rsl__table input { accent-color: var(--accent); width: 16px; height: 16px; }\n.rsl--stripe tbody tr:nth-child(even) { background: #24143008; }\n.rsl[data-active=\"1\"] tbody tr:nth-child(1) { background: #A8E6C155; }\n.rsl[data-active=\"2\"] tbody tr:nth-child(2) { background: #A8E6C155; }\n.rsl[data-active=\"3\"] tbody tr:nth-child(3) { background: #A8E6C155; }\n</style>",
    "tailwind": "<div class=\"max-w-[480px] rounded-[10px] border border-[#24143020] font-sans text-sm text-[#241430] bg-[#FAF7F2] overflow-hidden{{#if stripe}} [&_tbody_tr:nth-child(even)]:bg-[#24143008]{{/if}}\" data-active=\"{{activeRow}}\" style=\"--accent:{{accent}};\">\n  <div class=\"overflow-x-auto\">\n    <table class=\"border-collapse w-full\">\n      <caption class=\"text-left font-semibold px-3.5 py-2.5\">{{caption}}</caption>\n      <thead><tr class=\"text-[#FAF7F2]\" style=\"background:{{accent}}\">\n        <th scope=\"col\" class=\"p-3.5\"><span class=\"sr-only\">Select</span></th>\n        <th scope=\"col\" class=\"p-3.5 text-left whitespace-nowrap\">Order</th>\n        <th scope=\"col\" class=\"p-3.5 text-left whitespace-nowrap\">Customer</th>\n        <th scope=\"col\" class=\"p-3.5 text-left whitespace-nowrap\">Total</th>\n      </tr></thead>\n      <tbody>\n        {{#if multiSelect}}\n        <tr><td class=\"p-3.5 border-b border-[#24143020]\"><label class=\"inline-flex\"><input type=\"checkbox\" checked class=\"[accent-color:var(--accent)] w-4 h-4\"><span class=\"sr-only\">Select order #1042</span></label></td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">#1042</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">A. Whitfield</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">£64.00</td></tr>\n        <tr><td class=\"p-3.5 border-b border-[#24143020]\"><label class=\"inline-flex\"><input type=\"checkbox\" class=\"[accent-color:var(--accent)] w-4 h-4\"><span class=\"sr-only\">Select order #1041</span></label></td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">#1041</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">R. Okafor</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">£128.50</td></tr>\n        <tr><td class=\"p-3.5 border-b border-[#24143020]\"><label class=\"inline-flex\"><input type=\"checkbox\" class=\"[accent-color:var(--accent)] w-4 h-4\"><span class=\"sr-only\">Select order #1040</span></label></td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">#1040</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">M. Iqbal</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">£22.00</td></tr>\n        {{/if}}\n        {{#unless multiSelect}}\n        <tr><td class=\"p-3.5 border-b border-[#24143020]\"><label class=\"inline-flex\"><input type=\"radio\" name=\"rsl-row\" checked class=\"[accent-color:var(--accent)] w-4 h-4\"><span class=\"sr-only\">Select order #1042</span></label></td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">#1042</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">A. Whitfield</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">£64.00</td></tr>\n        <tr><td class=\"p-3.5 border-b border-[#24143020]\"><label class=\"inline-flex\"><input type=\"radio\" name=\"rsl-row\" class=\"[accent-color:var(--accent)] w-4 h-4\"><span class=\"sr-only\">Select order #1041</span></label></td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">#1041</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">R. Okafor</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">£128.50</td></tr>\n        <tr><td class=\"p-3.5 border-b border-[#24143020]\"><label class=\"inline-flex\"><input type=\"radio\" name=\"rsl-row\" class=\"[accent-color:var(--accent)] w-4 h-4\"><span class=\"sr-only\">Select order #1040</span></label></td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">#1040</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">M. Iqbal</td><td class=\"p-3.5 border-b border-[#24143020] whitespace-nowrap\">£22.00</td></tr>\n        {{/unless}}\n      </tbody>\n    </table>\n  </div>\n</div>\n<style>\n.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}\n[data-active=\"1\"] tbody tr:nth-child(1) { background: #A8E6C155; }\n[data-active=\"2\"] tbody tr:nth-child(2) { background: #A8E6C155; }\n[data-active=\"3\"] tbody tr:nth-child(3) { background: #A8E6C155; }\n</style>",
    "react": "function RowSelection({\n  caption = \"{{caption}}\",\n  accent = \"{{accent}}\",\n  multiSelect = {{multiSelect}},\n  activeRow = \"{{activeRow}}\",\n  stripe = {{stripe}},\n}) {\n  const rows = [\n    [\"#1042\", \"A. Whitfield\", \"£64.00\"],\n    [\"#1041\", \"R. Okafor\", \"£128.50\"],\n    [\"#1040\", \"M. Iqbal\", \"£22.00\"],\n  ];\n  const cell = { padding: \"10px 14px\", borderBottom: \"1px solid #24143020\", whiteSpace: \"nowrap\" };\n  const active = Number(activeRow);\n  return (\n    <div style={{ maxWidth: 480, borderRadius: 10, border: \"1px solid #24143020\", overflow: \"hidden\", font: \"14px system-ui, sans-serif\", color: \"#241430\", background: \"#FAF7F2\" }}>\n      <div style={{ overflowX: \"auto\" }}>\n        <table style={{ borderCollapse: \"collapse\", width: \"100%\" }}>\n          <caption style={{ textAlign: \"left\", fontWeight: 600, padding: \"10px 14px\" }}>{caption}</caption>\n          <thead>\n            <tr style={{ background: accent, color: \"#FAF7F2\" }}>\n              <th scope=\"col\" style={cell}></th>\n              {[\"Order\", \"Customer\", \"Total\"].map((h) => <th key={h} scope=\"col\" style={cell}>{h}</th>)}\n            </tr>\n          </thead>\n          <tbody>\n            {rows.map((row, i) => (\n              <tr key={row[0]} style={{ background: active === i + 1 ? \"#A8E6C155\" : stripe && i % 2 === 1 ? \"#24143008\" : \"transparent\" }}>\n                <td style={cell}>\n                  {multiSelect\n                    ? <input type=\"checkbox\" defaultChecked={i === 0} aria-label={`Select order ${row[0]}`} style={{ accentColor: accent, width: 16, height: 16 }} />\n                    : <input type=\"radio\" name=\"rsl-row\" defaultChecked={i === 0} aria-label={`Select order ${row[0]}`} style={{ accentColor: accent, width: 16, height: 16 }} />}\n                </td>\n                {row.map((c, j) => <td key={j} style={cell}>{c}</td>)}\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n}"
  }
}
