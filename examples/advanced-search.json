{
  "slug": "advanced-search",
  "controls_schema": [
    {
      "id": "label",
      "type": "text",
      "label": "Legend",
      "default": "Advanced search"
    },
    {
      "id": "matchType",
      "type": "select",
      "label": "Match type",
      "default": "any word",
      "options": [
        "any word",
        "all words",
        "exact phrase"
      ]
    },
    {
      "id": "placeholder",
      "type": "text",
      "label": "Placeholder",
      "default": "author, title, or keyword"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Focus colour",
      "default": "#BFD9F2",
      "presets": [
        "#BFD9F2",
        "#A8E6C1",
        "#F5C2E0",
        "#D9C8F0",
        "#E8A020",
        "#241430"
      ]
    },
    {
      "id": "radius",
      "type": "number",
      "label": "Corner radius",
      "default": 8,
      "min": 0,
      "max": 16,
      "step": 1
    }
  ],
  "templates": {
    "html": "<form class=\"asearch\" role=\"search\" style=\"--accent:{{accent}};\">\n  <fieldset class=\"asearch__fieldset\" style=\"border-radius:{{radius}}px;\">\n    <legend class=\"asearch__legend\">{{label}}</legend>\n    <label class=\"asearch__field\">\n      <span class=\"asearch__field-label\">Keywords</span>\n      <input class=\"asearch__input\" type=\"search\" name=\"keywords\" placeholder=\"{{placeholder}}\" style=\"border-radius:{{radius}}px;\">\n    </label>\n    <label class=\"asearch__field\">\n      <span class=\"asearch__field-label\">Match type</span>\n      <select class=\"asearch__select\" name=\"matchType\" style=\"border-radius:{{radius}}px;\">\n        <option>any word</option>\n        <option>all words</option>\n        <option>exact phrase</option>\n      </select>\n    </label>\n    <label class=\"asearch__field\">\n      <span class=\"asearch__field-label\">Published after</span>\n      <input class=\"asearch__input\" type=\"text\" name=\"after\" placeholder=\"YYYY-MM-DD\" style=\"border-radius:{{radius}}px;\">\n    </label>\n    <p class=\"asearch__hint\">Matches <strong>{{matchType}}</strong> of your keywords.</p>\n    <button class=\"asearch__submit\" type=\"submit\" style=\"border-radius:{{radius}}px;\">Search</button>\n  </fieldset>\n</form>\n<style>\n.asearch { font: 14px system-ui, sans-serif; color: #241430; max-width: 340px; }\n.asearch__fieldset { border: 1.5px solid #24143026; padding: 16px; display: grid; gap: 12px; }\n.asearch__legend { padding: 0 6px; font-weight: 600; }\n.asearch__field { display: block; }\n.asearch__field-label { display: block; margin-bottom: 4px; font-weight: 500; font-size: 13px; }\n.asearch__input, .asearch__select { width: 100%; box-sizing: border-box; padding: 8px 10px; font: inherit; color: #241430; background: #FAF7F2; border: 1.5px solid #24143040; appearance: none; }\n.asearch__input:focus-visible, .asearch__select:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }\n.asearch__hint { margin: 0; font-size: 12px; color: #24143099; }\n.asearch__submit { justify-self: start; padding: 8px 16px; font: inherit; font-weight: 600; color: #241430; background: var(--accent); border: none; cursor: pointer; }\n.asearch__submit:hover { filter: brightness(0.95); }\n.asearch__submit:focus-visible { outline: 2px solid #241430; outline-offset: 2px; }\n</style>",
    "tailwind": "<form role=\"search\" class=\"font-sans text-sm text-[#241430] max-w-[340px]\" style=\"--accent:{{accent}};\">\n  <fieldset class=\"border-[1.5px] border-[#24143026] p-4 grid gap-3\" style=\"border-radius:{{radius}}px;\">\n    <legend class=\"px-1.5 font-semibold\">{{label}}</legend>\n    <label class=\"block\">\n      <span class=\"block mb-1 font-medium text-[13px]\">Keywords</span>\n      <input type=\"search\" name=\"keywords\" placeholder=\"{{placeholder}}\" style=\"border-radius:{{radius}}px;\" class=\"w-full box-border px-2.5 py-2 text-[#241430] bg-[#FAF7F2] border-[1.5px] border-[#24143040] appearance-none focus-visible:outline-none focus-visible:border-[var(--accent)] focus-visible:shadow-[0_0_0_3px_color-mix(in_srgb,var(--accent)_35%,transparent)]\">\n    </label>\n    <label class=\"block\">\n      <span class=\"block mb-1 font-medium text-[13px]\">Match type</span>\n      <select name=\"matchType\" style=\"border-radius:{{radius}}px;\" class=\"w-full box-border px-2.5 py-2 text-[#241430] bg-[#FAF7F2] border-[1.5px] border-[#24143040] appearance-none focus-visible:outline-none focus-visible:border-[var(--accent)]\">\n        <option>any word</option>\n        <option>all words</option>\n        <option>exact phrase</option>\n      </select>\n    </label>\n    <label class=\"block\">\n      <span class=\"block mb-1 font-medium text-[13px]\">Published after</span>\n      <input type=\"text\" name=\"after\" placeholder=\"YYYY-MM-DD\" style=\"border-radius:{{radius}}px;\" class=\"w-full box-border px-2.5 py-2 text-[#241430] bg-[#FAF7F2] border-[1.5px] border-[#24143040]\">\n    </label>\n    <p class=\"m-0 text-xs text-[#24143099]\">Matches <strong>{{matchType}}</strong> of your keywords.</p>\n    <button type=\"submit\" style=\"border-radius:{{radius}}px;\" class=\"justify-self-start px-4 py-2 font-semibold text-[#241430] bg-[var(--accent)] border-none cursor-pointer hover:brightness-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#241430] focus-visible:outline-offset-2\">Search</button>\n  </fieldset>\n</form>",
    "react": "export function AdvancedSearch({\n  label = \"{{label}}\",\n  matchType = \"{{matchType}}\",\n  placeholder = \"{{placeholder}}\",\n  accent = \"{{accent}}\",\n  radius = {{radius}},\n}) {\n  return (\n    <form role=\"search\" style={{ fontFamily: \"system-ui, sans-serif\", fontSize: 14, color: \"#241430\", maxWidth: 340, \"--accent\": accent }}>\n      <fieldset style={{ border: \"1.5px solid #24143026\", padding: 16, display: \"grid\", gap: 12, borderRadius: radius }}>\n        <legend style={{ padding: \"0 6px\", fontWeight: 600 }}>{label}</legend>\n        <label style={{ display: \"block\" }}>\n          <span style={{ display: \"block\", marginBottom: 4, fontWeight: 500, fontSize: 13 }}>Keywords</span>\n          <input type=\"search\" name=\"keywords\" placeholder={placeholder} style={{ width: \"100%\", boxSizing: \"border-box\", padding: \"8px 10px\", font: \"inherit\", color: \"#241430\", background: \"#FAF7F2\", border: \"1.5px solid #24143040\", borderRadius: radius }} />\n        </label>\n        <label style={{ display: \"block\" }}>\n          <span style={{ display: \"block\", marginBottom: 4, fontWeight: 500, fontSize: 13 }}>Match type</span>\n          <select name=\"matchType\" defaultValue={matchType} style={{ width: \"100%\", boxSizing: \"border-box\", padding: \"8px 10px\", color: \"#241430\", background: \"#FAF7F2\", border: \"1.5px solid #24143040\", appearance: \"none\", borderRadius: radius }}>\n            <option>any word</option>\n            <option>all words</option>\n            <option>exact phrase</option>\n          </select>\n        </label>\n        <label style={{ display: \"block\" }}>\n          <span style={{ display: \"block\", marginBottom: 4, fontWeight: 500, fontSize: 13 }}>Published after</span>\n          <input type=\"text\" name=\"after\" placeholder=\"YYYY-MM-DD\" style={{ width: \"100%\", boxSizing: \"border-box\", padding: \"8px 10px\", color: \"#241430\", background: \"#FAF7F2\", border: \"1.5px solid #24143040\", borderRadius: radius }} />\n        </label>\n        <p style={{ margin: 0, fontSize: 12, color: \"#24143099\" }}>Matches <strong>{matchType}</strong> of your keywords.</p>\n        <button type=\"submit\" style={{ justifySelf: \"start\", padding: \"8px 16px\", fontWeight: 600, color: \"#241430\", background: accent, border: \"none\", cursor: \"pointer\", borderRadius: radius }}>Search</button>\n      </fieldset>\n    </form>\n  );\n}"
  }
}
